{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termimus",
  "version": "0.6.2",
  "identifier": "com.termimus.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termimus",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 400,
        "decorations": false,
        "shadow": false,
        "backgroundColor": [10, 14, 20, 255],
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
